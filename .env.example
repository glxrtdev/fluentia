# Supabase Postgres connection string.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the "Transaction pooler" URI (port 6543) when deploying to serverless.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 32-byte hex secret. Generate with: npm run setup
# Encrypts each user's OpenAI API key at rest (AES-256-GCM).
# Rotating it makes every stored key unreadable.
ENCRYPTION_KEY=

# Optional: default models (each user pays with their own OpenAI key)
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional: point at an OpenAI-compatible gateway (used by the voice-loop test)
# OPENAI_BASE_URL=
